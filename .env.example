# AI provider
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# Key the Express backend must send as X-Service-Key when calling this service.
SERVICE_API_KEY=replace-with-a-long-random-value

# Existing deterministic Express backend
EXPRESS_API_BASE_URL=http://127.0.0.1:3000
EXPRESS_SERVICE_TOKEN=
EXPRESS_REQUEST_TIMEOUT_SECONDS=10

# Callback credential: must match AI_MODERATION_SERVICE_KEY in Backend .env.
# Separate from SERVICE_API_KEY, which protects incoming requests to AI.
AI_MODERATION_SERVICE_KEY=

# Versioned deterministic policy gates around model moderation output.
MODERATION_POLICY_VERSION=2026-10-15
MODERATION_FLAG_CONFIDENCE_THRESHOLD=0.85
MODERATION_BLOCK_CONFIDENCE_THRESHOLD=0.95

# Application
APP_ENV=development
LOG_LEVEL=INFO
